# PrepArr environment variables. Env overrides the config file; CLI flags override env.
# Full reference: docs/src/content/docs/configuration/environment-variables.md

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=servarr
POSTGRES_LOG_DATABASE_ENABLED=true
POSTGRES_SKIP_PROVISIONING=false

# Servarr instance (sonarr|radarr|lidarr|readarr|prowlarr|qbittorrent|bazarr|auto)
SERVARR_URL=http://sonarr:8989
SERVARR_TYPE=sonarr
# SERVARR_API_KEY=
SERVARR_ADMIN_USER=admin
SERVARR_ADMIN_PASSWORD=change-me
SERVARR_AUTHENTICATION_METHOD=forms

# Service integration (optional; uncomment to use)
# QBITTORRENT_URL=
# QBITTORRENT_USER=
# QBITTORRENT_PASSWORD=
# PROWLARR_URL=
# PROWLARR_API_KEY=
# BAZARR_URL=
# BAZARR_API_KEY=

# Configuration
CONFIG_PATH=/config/servarr.yaml
CONFIG_WATCH=true
CONFIG_RECONCILE_INTERVAL=60
HEALTH_PORT=8080

# Logging (read from the environment only)
LOG_LEVEL=info
LOG_FORMAT=json
